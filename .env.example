PUBLIC_VERSION="at" # set to at for Austria, de for Germany, org for klimadashboard.org
PUBLIC_CARTO_API_KEY="" # optional CARTO API key, appended to all CARTO basemap tile/style requests

API_URL="https://base.klimadashboard.org"
DIRECTUS_TOKEN="" # include your Directus API access token here for write access and extended read access

# the following variables are only needed for klimadashboard.org & its donation & finance features
STRIPE_SECRET_KEY=""
CAMP_API_KEY=""
CAMP_ORG_ID=""
CAMP_MANDATE_ID=""

# Brevo newsletter signup (footer double opt-in)
BREVO_API_KEY=""
BREVO_DOI_TEMPLATE_ID="" # transactional template id, its confirm link must use {{ params.DOIurl }}
BREVO_DOI_REDIRECT_URL="" # page the subscriber lands on after confirming, e.g. https://klimadashboard.org/newsletter/thanks